; DT9837 A/B/C family USB IDs. LabDAQ confirms subtype C before acquisition.
; Publish only with the matching signed catalog labdaq-winusb.cat.
[Version]
Signature="$Windows NT$"
Class=USBDevice
ClassGUID={88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider=%Provider%
CatalogFile=labdaq-winusb.cat
DriverVer=10/25/2026,0.2.0.0
PnpLockdown=1

[Manufacturer]
%Provider%=Devices,NTamd64

[Devices.NTamd64]
%Cold%=USB_Install,USB\VID_0867&PID_9839
%Runtime%=USB_Install,USB\VID_0867&PID_3998

[USB_Install]
Include=winusb.inf
Needs=WINUSB.NT

[USB_Install.Services]
Include=winusb.inf
Needs=WINUSB.NT.Services

[USB_Install.HW]
AddReg=Interface

[Interface]
HKR,,DeviceInterfaceGUIDs,0x10000,"{1F7DE194-BD7A-4D24-82B8-51B0F2147C24}"

[Strings]
Provider="LabDAQ"
Cold="LabDAQ DT9837 family firmware loader"
Runtime="LabDAQ DT9837 family acquisition"
